#include <iostream>
using namespace std;

// Node structure for BST
struct Node {
    int data;
    Node* left;
    Node* right;
    
    Node(int value) {
        data = value;
        left = nullptr;
        right = nullptr;
    }
};

class BinarySearchTree {
private:
    Node* root;
    
    // Insert node into BST
    Node* insertHelper(Node* node, int value) {
        if (node == nullptr) {
            return new Node(value);
        }
        
        if (value < node->data) {
            node->left = insertHelper(node->left, value);
        } else if (value > node->data) {
            node->right = insertHelper(node->right, value);
        }
        
        return node;
    }
    
    // Search a value in BST
    bool searchHelper(Node* node, int key) {
        if (node == nullptr) {
            return false;
        }
        
        if (key == node->data) {
            return true;
        } else if (key < node->data) {
            return searchHelper(node->left, key);
        } else {
            return searchHelper(node->right, key);
        }
    }
    
    // Find minimum value
    Node* findMinHelper(Node* node) {
        if (node == nullptr) {
            return nullptr;
        }
        
        while (node->left != nullptr) {
            node = node->left;
        }
        return node;
    }
    
    // Find maximum value
    Node* findMaxHelper(Node* node) {
        if (node == nullptr) {
            return nullptr;
        }
        
        while (node->right != nullptr) {
            node = node->right;
        }
        return node;
    }
    
    // Delete node from BST
    Node* deleteHelper(Node* node, int value) {
        if (node == nullptr) {
            return nullptr;
        }
        
        if (value < node->data) {
            node->left = deleteHelper(node->left, value);
        } else if (value > node->data) {
            node->right = deleteHelper(node->right, value);
        } else {
            if (node->left == nullptr && node->right == nullptr) {
                delete node;
                return nullptr;
            }
            else if (node->left == nullptr) {
                Node* temp = node->right;
                delete node;
                return temp;
            }
            else if (node->right == nullptr) {
                Node* temp = node->left;
                delete node;
                return temp;
            }
            else {
                Node* successor = findMinHelper(node->right);
                node->data = successor->data;
                node->right = deleteHelper(node->right, successor->data);
            }
        }
        return node;
    }
    
    // Display BST in sorted order
    void inorderHelper(Node* node) {
        if (node != nullptr) {
            inorderHelper(node->left);
            cout << node->data << " ";
            inorderHelper(node->right);
        }
    }
    
public:
    BinarySearchTree() {
        root = nullptr;
    }
    
    // Insert value
    void insert(int value) {
        root = insertHelper(root, value);
        cout << "Inserted " << value << " into the BST.\n";
    }
    
    // Search value
    bool search(int key) {
        return searchHelper(root, key);
    }
    
    // Get minimum value
    int findMin() {
        Node* minNode = findMinHelper(root);
        if (minNode != nullptr) return minNode->data;
        throw runtime_error("Tree is empty");
    }
    
    // Get maximum value
    int findMax() {
        Node* maxNode = findMaxHelper(root);
        if (maxNode != nullptr) return maxNode->data;
        throw runtime_error("Tree is empty");
    }
    
    // Delete value
    void deleteNode(int value) {
        if (!search(value)) {
            cout << "Value " << value << " not found in the tree.\n";
            return;
        }
        root = deleteHelper(root, value);
        cout << "Deleted " << value << " from the BST.\n";
    }
    
    // Display tree
    void display() {
        if (root == nullptr) {
            cout << "Tree is empty.\n";
            return;
        }
        cout << "Inorder traversal: ";
        inorderHelper(root);
        cout << endl;
    }
};

// Menu display
void showMenu() {
    cout << "\n=== BINARY SEARCH TREE OPERATIONS ===\n";
    cout << "1. Insert a value\n";
    cout << "2. Search for a key\n";
    cout << "3. Find Minimum value\n";
    cout << "4. Find Maximum value\n";
    cout << "5. Delete a value\n";
    cout << "6. Display the tree (Inorder)\n";
    cout << "7. Exit\n";
    cout << "Enter your choice: ";
}

int main() {
    BinarySearchTree bst;
    int choice, value;
    
    do {
        showMenu();
        cin >> choice;
        
        switch(choice) {
            case 1:
                cout << "Enter value to insert: ";
                cin >> value;
                bst.insert(value);
                break;
                
            case 2:
                cout << "Enter key to search: ";
                cin >> value;
                if (bst.search(value))
                    cout << "Key found in BST.\n";
                else
                    cout << "Key not found in BST.\n";
                break;
                
            case 3:
                try {
                    cout << "Minimum value: " << bst.findMin() << endl;
                } catch (...) {
                    cout << "Tree is empty\n";
                }
                break;
                
            case 4:
                try {
                    cout << "Maximum value: " << bst.findMax() << endl;
                } catch (...) {
                    cout << "Tree is empty\n";
                }
                break;
                
            case 5:
                cout << "Enter value to delete: ";
                cin >> value;
                bst.deleteNode(value);
                break;
                
            case 6:
                bst.display();
                break;
                
            case 7:
                cout << "Exiting program...\n";
                break;
                
            default:
                cout << "Invalid choice!\n";
        }
        
    } while(choice != 7);

    return 0;
}
